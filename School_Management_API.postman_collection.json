{
  "info": {
    "_postman_id": "school-mgmt-api-v1",
    "name": "School Management System API",
    "description": "Comprehensive API collection for School Management System.\n\n## Setup\n1. Set `baseUrl` collection variable to `http://localhost:5007` (already set).\n2. Run **Login** first — it automatically saves the `csrfToken` to collection variables.\n3. Postman's cookie jar handles `accessToken` and `refreshToken` automatically.\n4. All protected requests use `x-csrf-token: {{csrfToken}}` header (already configured).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "description": "Authentication endpoints for user login, logout, and token refresh.",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    // Iterate ALL Set-Cookie headers to find the real csrfToken",
                  "    // (login clears old cookies first, then sets new ones)",
                  "    var csrfToken = null;",
                  "    pm.response.headers.all().forEach(function(header) {",
                  "        if (header.key.toLowerCase() === 'set-cookie') {",
                  "            var match = header.value.match(/csrfToken=([^;]+)/);",
                  "            if (match && match[1] && match[1].length > 5) {",
                  "                csrfToken = match[1];",
                  "            }",
                  "        }",
                  "    });",
                  "    if (csrfToken) {",
                  "        pm.collectionVariables.set('csrfToken', csrfToken);",
                  "        console.log('CSRF Token saved: ' + csrfToken);",
                  "    }",
                  "    pm.test('Login successful', function() {",
                  "        pm.expect(pm.response.code).to.equal(200);",
                  "    });",
                  "    pm.test('Response has user info', function() {",
                  "        var json = pm.response.json();",
                  "        pm.expect(json).to.have.property('id');",
                  "        pm.expect(json).to.have.property('role');",
                  "    });",
                  "    pm.test('CSRF token saved', function() {",
                  "        pm.expect(pm.collectionVariables.get('csrfToken')).to.be.a('string').and.not.empty;",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin@school-admin.com\",\n  \"password\": \"3OU4zn3q6Zh9\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          },
          "response": []
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    // Extract new csrfToken from Set-Cookie headers",
                  "    var csrfToken = null;",
                  "    pm.response.headers.all().forEach(function(header) {",
                  "        if (header.key.toLowerCase() === 'set-cookie') {",
                  "            var match = header.value.match(/csrfToken=([^;]+)/);",
                  "            if (match && match[1] && match[1].length > 5) {",
                  "                csrfToken = match[1];",
                  "            }",
                  "        }",
                  "    });",
                  "    if (csrfToken) {",
                  "        pm.collectionVariables.set('csrfToken', csrfToken);",
                  "        console.log('New CSRF Token saved: ' + csrfToken);",
                  "    }",
                  "    pm.test('Token refreshed successfully', function() {",
                  "        pm.expect(pm.response.code).to.equal(200);",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "refresh"]
            }
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-csrf-token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "logout"]
            }
          },
          "response": []
        }
      ]
    },
